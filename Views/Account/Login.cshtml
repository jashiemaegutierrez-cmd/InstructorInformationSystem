@model InstructorInformationsSystem.Models.LoginViewModel

@{
    ViewData["Title"] = "Admin Login";
}

<div class="auth-card">
    <h2 class="form-title">Admin Login</h2>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" id="alertMessage">
            @TempData["ErrorMessage"]
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <form asp-action="Login" method="post" id="loginForm">
        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-control" id="LoginEmail" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password"></label>
            <input asp-for="Password" type="password" class="form-control" id="LoginPassword" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group checkbox-group">
            <input type="checkbox" id="showLoginPasswordToggle" onclick="toggleLoginPassword()" />
            <label for="showLoginPasswordToggle">Show Password</label>
        </div>

        <div id="jsLoginValidationError" class="alert alert-danger" style="display:none;"></div>

        <button type="submit" class="btn btn-primary" id="btnLogin">Login</button>
    </form>
    <p class="auth-switch">Don't have an account? <a asp-action="Register">Register here</a></p>
</div>