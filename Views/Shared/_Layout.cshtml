@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InstructorInformationsSystem</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Abril+Fatface&family=EB+Garamond:wght@400;500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="navbar-header">
        <div class="container nav-wrapper">
            <h1 class="system-title">
                <a asp-controller="Account" asp-action="Dashboard">InstructorInformationsSystem</a>
            </h1>
            <nav class="nav-links">
                @if (Context.Session.GetString("AdminUser") != null)
                {
                    <a asp-controller="Account" asp-action="Dashboard">Dashboard</a>
                    <a asp-controller="Instructor" asp-action="Index">Instructors</a>
                    <a asp-controller="Account" asp-action="Logout" class="nav-btn" style="color: #d87093;">Logout (@Context.Session.GetString("AdminName"))</a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Register">Register</a>
                    <a asp-controller="Account" asp-action="Login" class="nav-btn">Login</a>
                }
            </nav>
        </div>
    </header>

    <main class="container main-content">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">
            <p>&copy; 2026 - InstructorInformationsSystem | Built for Academic Excellence</p>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>