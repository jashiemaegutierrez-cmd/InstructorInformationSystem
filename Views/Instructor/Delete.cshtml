@model InstructorInformationsSystem.Models.Instructor

@{
    ViewData["Title"] = "Delete Instructor";
}

<div class="auth-card" style="max-width: 500px;">
    <h2 class="form-title" style="color: #d87093;">Delete Instructor</h2>
    <p>Are you sure you want to delete this instructor?</p>

    <div style="margin-bottom: 20px;">
        <p><strong>Name:</strong> @Model.FullName</p>
        <p><strong>Designation:</strong> @Model.Designation</p>
        <p><strong>Majorship:</strong> @Model.Majorship</p>
        <p><strong>Email:</strong> @Model.EmailAddress</p>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="InstructorId" />
        <button type="submit" class="btn btn-primary" style="background-color: #d87093; color: white;">Confirm Delete</button>
        <a asp-action="Index" style="display: block; text-align: center; margin-top: 15px; color: #555;">Cancel</a>
    </form>
</div>