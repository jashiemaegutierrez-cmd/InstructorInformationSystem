@model IEnumerable<InstructorInformationsSystem.Models.Instructor>

@{
    ViewData["Title"] = "Instructor List";
}

<div class="instructor-container">
    <h2>Instructor Directory</h2>

    <p>
        <a asp-action="Create" class="btn btn-primary" style="width: auto;">+ Add New Instructor</a>
    </p>

    <table class="table" style="width:100%; border-collapse: collapse; margin-top: 20px;">
        <thead>
            <tr style="background-color: #dbe9f4; text-align: left;">
                <th style="padding: 10px;">ID</th>
                <th style="padding: 10px;">Full Name</th>
                <th style="padding: 10px;">Designation</th>
                <th style="padding: 10px;">Majorship</th>
                <th style="padding: 10px;">Contact</th>
                <th style="padding: 10px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" style="text-align: center; padding: 25px; color: #666;">
                        No instructors found. Click <strong>"+ Add New Instructor"</strong> above to register an instructor.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr style="border-bottom: 1px solid #c2d8e8;">
                        <td style="padding: 10px;">@item.InstructorId</td>
                        <td style="padding: 10px;">@item.FullName</td>
                        <td style="padding: 10px;">@item.Designation</td>
                        <td style="padding: 10px;">@item.Majorship</td>
                        <td style="padding: 10px;">@item.ContactNumber</td>
                        <td style="padding: 10px;">
                            <a asp-action="Details" asp-route-id="@item.InstructorId" style="color: #2b4c5e;">Details</a> |
                            <a asp-action="Edit" asp-route-id="@item.InstructorId" style="color: #2b4c5e;">Edit</a> |
                            <a asp-action="Delete" asp-route-id="@item.InstructorId" style="color: #d87093;">Delete</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>